# Required: choose a unique password of at least 12 characters.
APP_PASSWORD=
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
# AI drafting/search is enabled when this is set. API usage is billed separately.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: HTTPS URL of the reverse proxy (e.g. https://research.example.com).
PUBLIC_URL=
# Optional server-side publisher credentials; alternatively enter them per session in UI.
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
OSF_TOKEN=
FIGSHARE_TOKEN=
ZENODO_TOKEN=
