# Required: choose a unique password of at least 12 characters.
APP_PASSWORD=
HOST=127.0.0.1
PORT=3000
# Docker publishes the application on localhost:3001; container port stays 3000.
STUDIO_PORT=3001
DATA_DIR=.data
# Optional Gemini key; recommended: save it through Connections in the app.
GEMINI_API_KEY=
# Optional paid OpenAI fallback only when Gemini is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: HTTPS URL of the reverse proxy (e.g. https://research.example.com).
PUBLIC_URL=
# Optional defaults so author/license are pre-filled instead of entered each time.
AUTHOR_DEFAULT=
# LICENSE_DEFAULT must be cc-by-4.0 or cc-by-sa-4.0 (anything else is ignored).
LICENSE_DEFAULT=
# Set RIGHTS_DEFAULT=true to also pre-confirm the rights checkbox (you attest you hold the rights).
RIGHTS_DEFAULT=
# Daily auto-draft from the sitemap: max new articles per run, earliest hour (container time), language.
AUTO_DRAFT_MAX=3
AUTO_DRAFT_HOUR=6
AUTO_DRAFT_LANGUAGE=English
# Optional server-side publisher credentials; alternatively enter them per session in UI.
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
OSF_TOKEN=
FIGSHARE_TOKEN=
ZENODO_TOKEN=
# Figshare also needs a category id (required by Figshare). The license is picked
# automatically to match the PDF; set FIGSHARE_LICENSE only to force a specific id.
FIGSHARE_CATEGORY=
FIGSHARE_LICENSE=
